{
  "identifier": "lumi_books",
  "version": "0.3.0",
  "name": "LumiBooks",
  "author": "AMousePad",
  "github": "https://github.com/AMousePad/LumiBooks",
  "homepage": "https://github.com/AMousePad/LumiBooks",
  "description": "LumiBooks compresses old chat into chapters, arcs, and volumes, then routes active summaries through a configurable world-info outlet.",
  "permissions": [
    "world_books",
    "chats",
    "chat_mutation",
    "generation",
    "characters",
    "regex_scripts"
  ],
  "interceptorTimeoutMs": 4000,
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "1.1.0"
}
